# =============================================================================
# Respondent — Community Edition Environment
# =============================================================================
# Copy to .env:  cp .env.example .env
#
# Used by:
#   - Docker Compose: env_file directive in compose.yaml
#
# Most settings are configured in respondent.yaml (same directory).
# This file is for secrets and build-time variables only.
# =============================================================================

# ─── Cesium Ion (optional) ──────────────────────────────────────────────────
# Cesium Ion access token — unlocks Bing Maps Aerial imagery + Ion terrain.
# Without this, the globe uses Stadia Maps dark tiles.
# Get a free token at https://ion.cesium.com/signup
#
# Build-time: baked into the Vite bundle during Docker image build
# VITE_CESIUM_ION_TOKEN=
# Runtime: injected by Go server into index.html (overrides build-time if set)
# RESPONDENT_FRONTEND_CESIUM_ION_TOKEN=

# ─── Source Credentials (optional) ──────────────────────────────────────────
# Sources that require API keys will silently fail (connect then disconnect,
# or receive HTTP 401/403) without valid credentials.

# NASA FIRMS Active Fire Data — https://firms.modaps.eosdis.nasa.gov/api/area/
# RESPONDENT_NASA_FIRMS_MAP_KEY=

# OpenAQ Air Quality — https://docs.openaq.org/
# RESPONDENT_OPENAQ_API_KEY=

# AISStream Maritime — https://aisstream.io/
# RESPONDENT_AISSTREAM_APY_KEY=

# PurpleAir Community Air Quality Sensors — https://develop.purpleair.com/
# RESPONDENT_PURPLEAIR_API_KEY=

# ACLED Armed Conflict Events — https://acleddata.com/
# RESPONDENT_ACLED_EMAIL=
# RESPONDENT_ACLED_PASSWORD=

# APRS.fi Amateur Radio Stations — https://aprs.fi/
# RESPONDENT_APRS_FI_API_KEY=

# Ukraine Air Raid Alerts — https://alerts.in.ua/
# RESPONDENT_UKRAINE_ALARM_TOKEN=

# Cloudflare Radar Internet Outages — https://radar.cloudflare.com/
# RESPONDENT_CLOUDFLARE_RADAR_TOKEN=

# Meshtastic LoRa Mesh — https://meshtastic.org/
# RESPONDENT_MESHTASTIC_USER=
# RESPONDENT_MESHTASTIC_PASS=

# ─── LLM API Keys (optional — enable AI features in respondent.community.yaml first) ──
# RESPONDENT_LLM_XAI_API_KEY=
# RESPONDENT_LLM_ZAI_API_KEY=
# RESPONDENT_LLM_OPENAI_API_KEY=
# RESPONDENT_LLM_ANTHROPIC_API_KEY=
# RESPONDENT_LLM_GEMINI_API_KEY=
