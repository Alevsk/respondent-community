{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./apps/command/src/*"],
      "@respondent/core": ["./packages/core/src/index.ts"],
      "@respondent/core/*": ["./packages/core/src/*"],
      "@respondent/earth": ["./apps/earth/src/index.ts"],
      "@respondent/earth/*": ["./apps/earth/src/*"]
    }
  },
  "include": ["apps/command/src", "apps/earth/src", "packages/core/src"]
}
